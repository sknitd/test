<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
	MagicForge is deliberately NOT sandboxed (no com.apple.security.app-sandbox key).
	The App Sandbox forbids everything the app exists to do: session-wide CGEvent taps,
	posting synthetic keyboard/mouse events, driving other apps' windows through the
	Accessibility API, and dlopen-ing the private MultitouchSupport.framework to read
	raw touch frames. The hardened runtime stays ON; the only exception requested is
	sending Apple events (user-approved AppleScript / app-control actions).
-->
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
